---
import CompanyDb from "../../database/company.json";
import Burger from "../../icons/Burger.astro";
import type { Company } from "../../models/Company";
import ContactCallActionButton from "../contacts/ContactCallActionButton.astro";
import { NAV_LINKS } from "./constants/NavLinks";
import NavSeparator from "./NavSeparator.astro";
import NavSocialMedia from "./NavSocialMedia.astro";
const company = CompanyDb as Company;
---

<div
  id="floating-nav"
  class="fixed top-2 md:top-4 left-1/2 -translate-x-1/2 z-50 flex items-center
         bg-background py-1.5 px-3 md:px-4 whitespace-nowrap rounded-full transition-all"
>
  <div
    class="flex items-center gap-2 w-full md:w-max justify-between md:justify-center"
  >
    <button
      id="menu-toggle"
      class="md:hidden flex items-center justify-center p-1.5 text-text/70 hover:text-text rounded-full hover:bg-text/8 transition-colors focus:outline-none"
      aria-label="Abrir menú"
    >
      <Burger />
    </button>

    <div
      id="nav-links-container"
      class="absolute top-[calc(100%+8px)] left-1/2 -translate-x-1/2 md:static md:translate-x-0 md:top-auto md:left-auto
             flex-col md:flex-row items-center
             bg-background md:bg-transparent shadow-[0_6px_24px_rgba(0,0,0,0.6)] md:shadow-none
             p-4 md:p-0 rounded-[20px] md:rounded-none
             hidden md:flex w-[85vw] max-w-[320px] md:w-max md:max-w-none transition-all duration-300"
    >
      <nav
        class="flex flex-col md:flex-row items-center gap-2 md:gap-1 w-full md:w-max"
      >
        {
          NAV_LINKS.map((link) => {
            if (link.name === "Logo") {
              return (
                <img
                  class="h-6 md:h-5 w-auto mx-1 md:mx-2"
                  src={company.logos.title}
                  alt={company.name}
                />
              );
            }
            return (
              <a
                href={link.href}
                class="mobile-link w-full md:w-auto text-center px-3 md:px-2.5 py-1.5 md:py-1 text-base md:text-[14px] font-medium tracking-wide text-text/60 hover:text-text rounded-full hover:bg-text/8 transition-all duration-200"
              >
                {link.name}
              </a>
            );
          })
        }
        <div class="flex items-center gap-2 md:gap-1.5 md:ml-1 mt-2 md:mt-0">
          <NavSocialMedia />
          <ContactCallActionButton size="sm" />
        </div>
      </nav>
    </div>
  </div>
</div>

<script>
  import { logEvent } from "firebase/analytics";
  import { analytics } from "../../firebase/client";

  const boton = document.getElementById("go-to-register");
  if (boton) {
    boton.addEventListener("click", () => {
      if (analytics) {
        logEvent(analytics, "Boton de inscribirse");
        console.log("Evento enviado a Analytics");
      }
    });
  }

  const menuToggle = document.getElementById("menu-toggle");
  const navContainer = document.getElementById("nav-links-container");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  if (menuToggle && navContainer) {
    menuToggle.addEventListener("click", () => {
      navContainer.classList.toggle("hidden");
      navContainer.classList.toggle("flex");
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (window.innerWidth < 768) {
          navContainer.classList.add("hidden");
          navContainer.classList.remove("flex");
        }
      });
    });
  }
</script>
