---
import CompanyDb from "../../database/company.json";
import type { Company } from "../../models/Company";
import { CONTACT_ROUTES } from "../../utils/path-builder/ContactRoutes";
import { LANDING_ROUTES } from "../../utils/path-builder/LandingRoutes";

import LinedIn from "../../icons/LinkedIn.astro";
import Instagram from "../../icons/Instagram.astro";
import Tiktok from "../../icons/Tiktok.astro";
import Facebook from "../../icons/Facebook.astro";

const company = CompanyDb as Company;

interface FooterLink {
  title: string;
  path?: string;
}

const currentYear = new Date().getFullYear();
const socialMedia = company.socialMedia;

const quickLinks = [
  {
    title: "Inicio",
    path: LANDING_ROUTES.hero,
  },
  {
    title: "Servicios",
    path: LANDING_ROUTES.services,
  },
  {
    title: "¿Por qué VigIA?",
    path: LANDING_ROUTES.whyToUse,
  },
  {
    title: "Contáctanos",
    path: CONTACT_ROUTES.form,
  },
];
const mainServices: FooterLink[] = [
  {
    title: "Analítica de Personas",
  },
  {
    title: "Detección de Intrusos",
  },
  {
    title: "Visión en Tiempo Real",
  },
  {
    title: "Integración Camaras sin Hardware Adicional",
  },
];
const capabilities: FooterLink[] = [
  {
    title: "Mapas de Calor",
  },
  {
    title: "Alertas Instantáneas",
  },
  {
    title: "Reportes Automatizados",
  },
  {
    title: "Control de Aforos",
  },
  {
    title: "Definición de Áreas",
  },
  {
    title: "Análisis de Flujos",
  },
];
---

<footer
  class="relative z-10 pt-20 pb-10 px-6 bg-transparent overflow-hidden flex flex-col items-center border-t border-primary/10"
  id="footer"
>
  <div class="max-w-[1200px] w-full mx-auto">
    <div
      class="flex flex-col lg:flex-row justify-between gap-12 lg:gap-24 mb-20"
    >
      <div class="max-w-[320px]">
        <a href="#hero" class="mb-5 block transition-opacity hover:opacity-80">
          {
            company.logos?.iconTitleRow ? (
              <img
                src={company.logos.iconTitleRow}
                alt={`${company.name} logo`}
                class="h-10 w-auto object-contain"
              />
            ) : (
              <h3 class="font-bold text-3xl text-text uppercase tracking-tight">
                {company.name || "VigIA"}
              </h3>
            )
          }
        </a>
        <p class="text-[0.95rem] text-muted font-medium leading-relaxed">
          {
            company.shortDescription ||
              "Transformamos cámaras de seguridad en sistemas de inteligencia activa."
          }
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-12 w-full">
        <div class="flex flex-col gap-5">
          <h4 class="font-semibold text-base text-text">Enlaces Rápidos</h4>
          <ul class="flex flex-col gap-3.5">
            {
              quickLinks.map((link) => (
                <li>
                  <a
                    href={link.path}
                    class="text-[0.95rem] text-muted hover:text-text transition-colors"
                  >
                    {link.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex flex-col gap-5">
          <h4 class="font-semibold text-base text-text">Servicios</h4>
          <ul class="flex flex-col gap-3.5">
            {
              mainServices.map((service) => (
                <li>
                  {service.path ? (
                    <a
                      href={service.path}
                      class="text-[0.95rem] text-muted hover:text-text transition-colors"
                    >
                      {service.title}
                    </a>
                  ) : (
                    <span class="text-[0.95rem] text-muted block cursor-default">
                      {service.title}
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex flex-col gap-5">
          <h4 class="font-semibold text-base text-text">Capacidades</h4>
          <ul class="flex flex-col gap-3.5">
            {
              capabilities.map((cap) => (
                <li>
                  <span class="text-[0.95rem] text-muted block cursor-default">
                    {cap.title}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex flex-col gap-5">
          <h4 class="font-semibold text-base text-text">Síguenos</h4>
          <ul class="flex flex-col gap-3.5">
            {
              socialMedia?.map((social) => {
                const nameLower = social.name.toLowerCase();
                return (
                  <li>
                    <a
                      href={social.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[0.95rem] text-muted hover:text-text transition-colors capitalize flex items-center gap-2"
                    >
                      <span class="w-4 h-4 flex items-center justify-center">
                        {nameLower === "linkedin" && <LinedIn />}
                        {nameLower === "instagram" && <Instagram />}
                        {nameLower === "tiktok" && <Tiktok />}
                        {nameLower === "facebook" && <Facebook />}
                      </span>
                      {social.name}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </div>

    <div
      class="flex flex-col md:flex-row justify-between items-center text-[0.85rem] text-muted mt-8 pt-8 border-t border-muted/10"
    >
      <p>
        &copy; {currentYear}
        {company.name || "VigIA"} Todos los derechos reservados.
      </p>
      <div class="mt-4 md:mt-0">
        <p>
          Diseñado con <span class="text-[var(--color-primary)]">♥</span> en 🇧🇴
        </p>
      </div>
    </div>
  </div>
</footer>
