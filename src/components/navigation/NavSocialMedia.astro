---
import CompanyDb from "../../database/company.json";
import type { Company } from "../../models/Company";
const company = CompanyDb as Company;
---

<div class="relative">
  <button
    id="social-dropdown-toggle"
    class="mobile-link w-full md:w-auto flex items-center justify-center gap-1 text-center px-4 md:px-3 py-2.5 md:py-1.5 text-base md:text-sm font-medium tracking-wide text-text/60 hover:text-text rounded-full hover:bg-text/8 transition-all duration-200"
  >
    Redes Sociales
    <svg
      id="social-dropdown-chevron"
      class="w-3.5 h-3.5 transition-transform duration-200"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </button>

  <div
    id="social-dropdown-menu"
    class="hidden absolute top-[calc(100%+8px)] left-1/2 -translate-x-1/2 md:left-auto md:right-0 md:translate-x-0
           flex flex-col bg-background shadow-[0_6px_24px_rgba(0,0,0,0.6)]
           rounded-[14px] p-1 w-32 z-50"
  >
    {
      company.socialMedia.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 text-xs font-medium text-text/60 hover:text-text rounded-full hover:bg-text/8 transition-all duration-200"
        >
          {social.name}
        </a>
      ))
    }
  </div>
</div>

<script>
  const toggle = document.getElementById("social-dropdown-toggle");
  const menu = document.getElementById("social-dropdown-menu");
  const chevron = document.getElementById("social-dropdown-chevron");

  if (toggle && menu && chevron) {
    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      menu.classList.toggle("hidden");
      chevron.classList.toggle("rotate-180");
    });

    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node) && e.target !== toggle) {
        menu.classList.add("hidden");
        chevron.classList.remove("rotate-180");
      }
    });
  }
</script>
