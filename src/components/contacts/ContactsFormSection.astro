---
import contactCallActionsDb from "../../database/contactCallActions.json";
import type { ContactCallActions } from "../../models/ContactCallActions";

import ContactsForm from "./ContactsForm";
import RecentWaitlistUsers from "./RecentContacts";

const contactCallActions = contactCallActionsDb as ContactCallActions;
---

<section
  id="waitlist-section"
  class="bg-background text-text py-16 px-16 relative z-10"
>
  <div class="max-w-4xl mx-auto text-center mb-10">
    <h2
      class="animate-item text-4xl md:text-5xl font-medium mb-3 tracking-tight"
    >
      {contactCallActions.title}
    </h2>
    <p
      class="animate-item text-muted text-sm md:text-base leading-relaxed max-w-3xl mx-auto"
    >
      {contactCallActions.description}
    </p>
  </div>

  <div
    id="waitlist-container"
    class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-[1fr_auto] gap-4 lg:gap-5 items-start"
  >
    <div class="flex flex-col gap-3 justify-center">
      <ul class="animate-item flex flex-col gap-3 mb-4">
        {
          contactCallActions.benefits.map((benefit) => (
            <li class="flex items-start gap-3">
              <span class="text-[var(--color-primary)] text-lg font-bold mt-0.5">
                ✓
              </span>
              <span class="text-base font-normal leading-snug">{benefit}</span>
            </li>
          ))
        }
      </ul>

      <div class="animate-item">
        <RecentWaitlistUsers client:load />
      </div>
    </div>

    <div class="animate-item">
      <ContactsForm
        client:load
        callAction={contactCallActions.call_to_action}
      />
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const container = document.querySelector("#waitlist-container");
  if (container) {
    gsap.from("#waitlist-container .animate-item", {
      y: 40,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: "power3.out",
      scrollTrigger: {
        trigger: container,
        start: "top 85%",
      },
    });
  }
</script>
