---
import { CONTACT_ROUTES } from "../../utils/path-builder/ContactRoutes";

interface Props {
  size?: "sm" | "md" | "lg";
}

const { size = "md" } = Astro.props;

const sizeClasses = {
  sm: "pl-3 pr-0.5 py-0.5 text-xs gap-1.5",
  md: "pl-4 pr-1 py-1 text-sm gap-2",
  lg: "pl-5 pr-1.5 py-1.5 text-base gap-2.5",
};
---

<a
  href={CONTACT_ROUTES.form}
  id="go-to-register"
  class={`inline-flex items-center rounded-full font-semibold tracking-wide
    bg-text/8 text-text/90 border border-text/15
    hover:border-text/30 hover:text-text hover:bg-text/12 transition-all duration-200 flex-shrink-0
    ${sizeClasses[size]}`}
>
  Reserva un Espacio
</a>
