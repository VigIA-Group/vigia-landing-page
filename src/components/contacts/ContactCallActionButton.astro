---
import { CONTACT_ROUTES } from "../../utils/path-builder/ContactRoutes";

interface Props {
  size?: "sm" | "md" | "lg";
}

const { size = "md" } = Astro.props;

const sizeClasses = {
  sm: "px-3.5 py-0.5 text-xs",
  md: "px-5 py-1 text-sm",
  lg: "px-6 py-2 text-base",
};
---

<a
  href={CONTACT_ROUTES.form}
  id="go-to-register"
  class={`cta-gradient inline-flex items-center rounded-full font-semibold tracking-wide
    text-white shadow-lg transition-all duration-300
    hover:scale-[1.02] hover:shadow-xl
    active:scale-[0.98]
    flex-shrink-0
    ${sizeClasses[size]}`}
>
  Agendar Demo
</a>

<style>
  .cta-gradient {
    background: linear-gradient(135deg, #02209a, #0a4ce8, #056efa, #2198f4);

    background-size: 200% 200%;

    animation:
      gradient-flow 6s ease infinite,
      pulse-glow 4s ease-in-out infinite;

    color: white;
  }

  @keyframes gradient-flow {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  @keyframes pulse-glow {
    0%,
    100% {
      box-shadow:
        0 0 0 0 rgba(5, 110, 250, 0.4),
        0 8px 20px rgba(2, 32, 154, 0.25);
    }

    50% {
      box-shadow:
        0 0 0 10px rgba(5, 110, 250, 0),
        0 12px 30px rgba(33, 152, 244, 0.4);
    }
  }
</style>
