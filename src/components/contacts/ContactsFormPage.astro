---
import contactCallActionsDb from "../../database/contactCallActions.json";
import type { ContactCallActions } from "../../models/ContactCallActions";
import RecentWaitlistUsers from "./RecentContacts";
import ContactsForm from "./ContactsForm";

const contactCallActions = contactCallActionsDb as ContactCallActions;
---

<section
  class="bg-background text-text py-24 px-6 relative overflow-hidden font-sans"
>
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[400px] bg-primary/10 blur-[120px] rounded-full pointer-events-none -z-10"
  >
  </div>

  <div
    id="waitlist-container"
    class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
  >
    <div class="flex flex-col justify-center">
      <h2
        class="animate-item text-5xl md:text-6xl font-medium mb-6 tracking-tight text-text leading-tight"
      >
        {contactCallActions.title}
      </h2>

      <p class="animate-item mb-10 text-muted text-lg leading-relaxed max-w-xl">
        {contactCallActions.description}
      </p>

      <ul class="animate-item flex flex-col gap-5 mb-10">
        {
          contactCallActions.benefits.map((benefit) => (
            <li class="flex items-start gap-3">
              <span class="text-primary text-xl font-bold mt-0.5">✓</span>
              <span class="text-lg font-normal leading-snug">{benefit}</span>
            </li>
          ))
        }
      </ul>

      <div class="animate-item">
        <RecentWaitlistUsers client:visible />
      </div>
    </div>

    <div class="animate-item w-full max-w-lg mx-auto lg:mx-0 lg:ml-auto">
      <ContactsForm
        client:visible
        callAction={contactCallActions.call_to_action}
        size="lg"
      />
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const container = document.querySelector("#waitlist-container");
  if (container) {
    gsap.from("#waitlist-container .animate-item", {
      y: 40,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: "power3.out",
      scrollTrigger: {
        trigger: container,
        start: "top 85%",
      },
    });
  }
</script>
