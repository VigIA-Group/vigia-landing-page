---
import CompanyDb from "../../database/company.json";
import type { Company } from "../../models/Company";
import ContactCallActionButton from "../contacts/ContactCallActionButton.astro";

const company: Company = CompanyDb;
---

<section
  id="hero"
  class="relative w-full h-screen bg-background overflow-hidden"
>
  <video
    id="hero-video"
    class="absolute inset-0 w-full h-full object-cover object-top z-0"
    muted
    playsinline
    data-videos={JSON.stringify(company.videos)}
  >
  </video>

  <div class="absolute inset-0 z-10 pointer-events-none">
    <div class="absolute inset-0 bg-background/25 hidden md:block"></div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-background/70 via-transparent to-background/80"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-background/40 via-transparent to-background/40"
    >
    </div>

    <div class="absolute inset-0 bg-background/80 md:hidden"></div>
  </div>

  <div
    class="absolute z-20 bottom-2 md:bottom-6 left-6 md:left-[clamp(1.5rem,3vw,3rem)] right-6 md:right-[clamp(1.5rem,3vw,3rem)] flex flex-col md:flex-row items-start md:items-end justify-between gap-6 pointer-events-auto pb-4 md:pb-12"
  >
    <div class="flex flex-col items-start justify-end gap-3 md:gap-4 max-w-2xl">
      <img
        src={company.logos.iconTitleRow}
        alt={`Logo de ${company.name}`}
        class="hero-logo w-48 md:w-56 lg:w-72 h-auto"
      />

      <p
        class="hero-slogan text-xl md:text-3xl lg:text-5xl font-semibold leading-[0.90] text-text/90 m-0 tracking-tight text-left"
      >
        La diferencia entre mirar y
        <strong class="text-[var(--color-primary)]">entender</strong>
      </p>

      <p
        class="hero-description text-base md:text-lg font-normal leading-relaxed m-0 text-left max-w-[500px]"
      >
        {company.shortDescription}
      </p>
    </div>

    <div class="hero-cta flex-shrink-0 mt-2 md:mt-0">
      <ContactCallActionButton size="lg" />
    </div>
  </div>

  <script>
    import gsap from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
      // Lógica del Video
      const videoEl = document.getElementById("hero-video") as HTMLVideoElement;
      if (videoEl) {
        const videos: string[] = JSON.parse(videoEl.dataset.videos || "[]");
        let currentVideoIndex = 0;

        if (videos.length > 0) {
          videoEl.src = videos[currentVideoIndex];
          videoEl.playbackRate = 1;
          videoEl.play().catch((e) => console.warn("Autoplay bloqueado:", e));

          videoEl.addEventListener("ended", () => {
            currentVideoIndex = (currentVideoIndex + 1) % videos.length;
            videoEl.src = videos[currentVideoIndex];
            videoEl.play();
          });
        }
      }

      // Lógica de Animación GSAP Unificada
      gsap.set(
        [".hero-logo", ".hero-slogan", ".hero-description", ".hero-cta"],
        { y: 20, opacity: 0, visibility: "visible" },
      );

      const tl = gsap.timeline({
        defaults: { ease: "power3.out", duration: 1.2 },
      });

      tl.to(".hero-logo", { y: 0, opacity: 1, duration: 1.2, delay: 0.2 })
        .to(".hero-slogan", { y: 0, opacity: 1, duration: 1.2 }, "-=1")
        .to(".hero-description", { y: 0, opacity: 1, duration: 1.2 }, "-=1")
        .to(".hero-cta", { y: 0, opacity: 1, duration: 1.0 }, "-=0.9");
    });
  </script>
</section>
